# Solana RPC Configuration (comma-separated for multi-RPC failover)
RPC_HTTP_URLS=https://api.mainnet-beta.solana.com,https://ultra-ultra-fog.solana-mainnet.quiknode.pro/48fa88a641cbd2a15f2e0c4f8d9c96c41c70fcf5/
RPC_WS_URLS=wss://api.mainnet-beta.solana.com,wss://ultra-ultra-fog.solana-mainnet.quiknode.pro/48fa88a641cbd2a15f2e0c4f8d9c96c41c70fcf5/

# Multi-RPC Mode: parallel (all WS at once, dedups) or rr (round-robin failover)
MULTI_RPC_MODE=parallel

# Circuit Breaker (for rr mode)
CB_FAIL_LIMIT=4
CB_COOLDOWN_SEC=30

# Legacy single URL support (deprecated - use RPC_HTTP_URLS/RPC_WS_URLS)
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Watcher Configuration
WATCHER_ENABLED=true
WATCH_DEDUP_MAX=50000

# Phase C FAST Mode Performance Settings
FAST_MODE=true
BACKFILL_CONCURRENCY=16
DB_BATCH_MAX=50
DB_BATCH_MS=150

# XIE Risk Analysis - DISABLED for maximum speed
XIE_MODE=off
RISK_GATE_MODE=warn-only
XIE_BACKGROUND_QPS=1

# Program IDs to watch (comma-separated)
# Pump.fun + Raydium AMM + Raydium CLMM
WATCH_PROGRAMS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P,675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8,CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqK

# Logging
LOG_LEVEL=INFO

# Multi-RPC parallel mode + XIE disabled (appended for override)
MULTI_RPC_MODE=parallel
XIE_MODE=off
RISK_GATE_MODE=warn-only
